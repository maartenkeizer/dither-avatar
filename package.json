{
  "name": "dither-avatar",
  "version": "1.0.0",
  "description": "Deterministic dithered SVG avatars from a seed string. Zero dependencies.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "avatar",
    "dither",
    "svg",
    "identicon",
    "react",
    "deterministic"
  ],
  "license": "MIT",
  "author": "Maarten Keizer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maartenkeizer/dither-avatar.git"
  },
  "bugs": {
    "url": "https://github.com/maartenkeizer/dither-avatar/issues"
  },
  "homepage": "https://maartenkeizer.github.io/dither-avatar",
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "@types/react": "^19.0.0"
  }
}
